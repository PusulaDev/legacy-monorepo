{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"],
      "@lib/*": ["*"],
      "@lib": ["index.ts"],
      "@/modules/*": ["types/*"]
    },
    "lib": ["esnext", "dom", "dom.iterable", "scripthost"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/playground/**/*.ts",
    "src/playground/**/*.vue",
    "shims-vue.d.ts"
  ],
    "exclude": ["node_modules", "dist"]
}
